            "fp1": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>We believe beauty doesn&rsquo;t need to be complicated to work. Every MiouvaLab product is built on a simple principle: ingredients that make sense, design that has a purpose, and an experience that feels good every day.</p>",
